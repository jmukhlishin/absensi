<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Absensi Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; background-color: #f4f7f6; }
        .container { max-width: 900px; margin: auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1, h2 { color: #333; text-align: center; }
        .nav { display: flex; justify-content: space-between; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #ddd; align-items: center; }
        .nav a { text-decoration: none; color: #007bff; font-weight: bold; margin-left: 15px; }
        .nav a:hover { text-decoration: underline; }
        
        .dashboard-info { display: flex; justify-content: space-between; flex-wrap: wrap; margin-bottom: 20px; }
        .info-card { background: #e9ecef; padding: 15px; border-radius: 6px; width: 48%; margin-bottom: 10px; box-sizing: border-box; }
        .info-card h3 { margin: 0 0 10px 0; font-size: 16px; color: #555; }
        .info-card p { margin: 0; font-size: 18px; font-weight: bold; color: #333; }
        
        .status-online { color: green; }
        .status-offline { color: red; }
        .status-syncing { color: #d39e00; }
        
        form { display: flex; flex-direction: column; gap: 15px; margin-bottom: 30px; padding: 20px; background-color: #f9f9f9; border-radius: 8px; }
        input, select, button { padding: 10px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px; }
        button { background-color: #28a745; color: white; cursor: pointer; border: none; font-weight: bold; }
        button:hover { background-color: #218838; }
        
        .table-container { max-height: 500px; overflow-y: auto; border: 1px solid #ddd; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 0; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #007bff; color: white; position: sticky; top: 0; z-index: 1; }
        tr:nth-child(even) { background-color: #f2f2f2; }

        /* Modal / Overlay untuk Loading Bar Sinkronisasi */
        body.sync-locked {
            overflow: hidden !important;
            pointer-events: none;
        }
        body.sync-locked .sync-overlay {
            pointer-events: all;
        }
        
        .sync-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 99999;
            user-select: none;
        }
        .sync-overlay.active {
            display: flex;
        }
        .sync-modal {
            background: white;
            padding: 30px;
            border-radius: 8px;
            width: 90%;
            max-width: 450px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .sync-title {
            font-size: 22px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }
        .sync-status-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 20px;
            min-height: 48px;
        }
        .progress-container {
            width: 100%;
            background-color: #e9ecef;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 15px;
            height: 25px;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
        }
        .progress-bar {
            height: 100%;
            width: 0%;
            background-color: #007bff;
            transition: width 0.3s ease;
            background-image: linear-gradient(45deg,rgba(255,255,255,.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,transparent 75%,transparent);
            background-size: 1rem 1rem;
            animation: progress-bar-stripes 1s linear infinite;
        }
        @keyframes progress-bar-stripes {
            from { background-position: 1rem 0; }
            to { background-position: 0 0; }
        }
        .progress-percentage {
            font-size: 18px;
            font-weight: bold;
            color: #007bff;
        }
        .btn-close-modal {
            display: none;
            margin-top: 20px;
            background-color: #6c757d;
            width: 100%;
        }
        .btn-close-modal:hover { background-color: #5a6268; }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav">
            <div>
                <strong>Login sebagai:</strong> <%= admin %>
            </div>
            <div style="display: flex; align-items: center; gap: 15px;">
                <a href="/">Dashboard</a>
                <a href="/karyawan">Kelola Karyawan</a>
                <form action="/print" method="GET" target="_blank" style="display: flex; flex-direction: row; gap: 5px; margin: 0; padding: 0; background: transparent; border: none; align-items: center; margin-left: 15px;">
                    <input type="date" name="start" required style="padding: 4px; font-size: 14px;">
                    <span style="font-size: 14px; font-weight: bold;">s/d</span>
                    <input type="date" name="end" required style="padding: 4px; font-size: 14px;">
                    <button type="submit" style="padding: 5px 10px; font-size: 14px; background-color: #007bff;">Cetak Laporan</button>
                </form>
            </div>
        </div>

        <h1>Dashboard Absensi</h1>
        
        <div class="dashboard-info">
            <div class="info-card">
                <h3>Waktu Sekarang</h3>
                <p id="clock">00:00:00</p>
            </div>
            <div class="info-card">
                <h3>Status Mesin (IP: 192.168.0.11)</h3>
                <p id="machine-status">Mengecek...</p>
            </div>
            <div class="info-card">
                <h3>Total Karyawan</h3>
                <p><span id="total-karyawan-count"><%= totalKaryawan %></span> Orang</p>
            </div>
            <div class="info-card">
                <h3>Sinkronisasi Manual (Incremental)</h3>
                <button type="button" onclick="startSync('karyawan')" style="width: 100%; padding: 8px; font-size:14px; background: #17a2b8; margin-bottom: 8px;">Tarik Data Karyawan</button>
                <button type="button" onclick="startSync('absensi')" style="width: 100%; padding: 8px; font-size:14px; background: #28a745;">Tarik Data Absensi</button>
            </div>
        </div>
        
        <h2>Log Absen Karyawan</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID Log</th>
                        <th>Nama</th>
                        <th>Waktu (Check-In / Out)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="absensi-table-body">
                    <% if (data.length > 0) { %>
                        <% data.forEach(row => { %>
                            <tr>
                                <td><%= row.id %></td>
                                <td><%= row.nama || 'Tidak Diketahui' %></td>
                                <td><%= row.waktu %></td>
                                <td><%= row.status %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr id="empty-row">
                            <td colspan="4" style="text-align: center;">Belum ada data absensi.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="pagination" id="pagination-controls" style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-bottom: 20px;">
            <% if (currentPage > 1) { %>
                <a href="/?page=<%= currentPage - 1 %>" style="padding: 8px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">Sebelumnya</a>
            <% } %>
            <span style="font-weight: bold;" id="page-info">Halaman <%= currentPage %> dari <%= totalPages %></span>
            <% if (currentPage < totalPages) { %>
                <a href="/?page=<%= currentPage + 1 %>" style="padding: 8px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">Selanjutnya</a>
            <% } %>
        </div>
    </div>

    <!-- Overlay Loading Bar Sinkronisasi -->
    <div id="sync-overlay" class="sync-overlay">
        <div class="sync-modal">
            <div class="sync-title" id="sync-title">Menarik Data...</div>
            <div class="progress-container">
                <div id="sync-progress-bar" class="progress-bar"></div>
            </div>
            <div id="sync-progress-text" class="progress-percentage">0%</div>
            <div class="sync-status-text" id="sync-status-text">Memulai proses...</div>
            <button id="btn-close-modal" class="btn-close-modal" onclick="closeSyncModal()">Tutup</button>
        </div>
    </div>

    <script>
        // Jam Realtime dengan Tanggal
        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('clock').innerText = now.toLocaleDateString('id-ID', options);
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Cek Status Mesin Realtime (Non-blocking)
        async function checkStatus() {
            try {
                const res = await fetch('/api/machine-status');
                const data = await res.json();
                const statusEl = document.getElementById('machine-status');
                if (data.syncing) {
                    statusEl.innerHTML = '<span class="status-syncing">Sedang Sinkronisasi...</span>';
                } else if (data.status === 'Online') {
                    statusEl.innerHTML = '<span class="status-online">Online (Terhubung)</span>';
                } else {
                    statusEl.innerHTML = '<span class="status-offline">Offline (Tidak Terhubung)</span>';
                }
            } catch (err) {
                document.getElementById('machine-status').innerHTML = '<span class="status-offline">Offline / Error</span>';
            }
        }
        setInterval(checkStatus, 10000); // Tiap 10 detik
        checkStatus();

        // Refresh Data Dashboard (Tanpa reload halaman)
        async function refreshDashboardStats() {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const page = urlParams.get('page') || 1;
                const res = await fetch('/api/dashboard-summary?page=' + page);
                const data = await res.json();
                
                // Update Tabel
                const tbody = document.getElementById('absensi-table-body');
                if (data.rows && data.rows.length > 0) {
                    let html = '';
                    data.rows.forEach(row => {
                        html += `<tr>
                            <td>${row.id}</td>
                            <td>${row.nama || 'Tidak Diketahui'}</td>
                            <td>${row.waktu}</td>
                            <td>${row.status}</td>
                        </tr>`;
                    });
                    tbody.innerHTML = html;
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align: center;">Belum ada data absensi.</td></tr>';
                }

                // Update Total Karyawan
                document.getElementById('total-karyawan-count').innerText = data.totalKaryawan || 0;

                // Update Pagination Info
                document.getElementById('page-info').innerText = `Halaman ${data.currentPage} dari ${data.totalPages}`;
                
                // Update Link Pagination
                const paginationControls = document.getElementById('pagination-controls');
                let phtml = '';
                if (data.currentPage > 1) {
                    phtml += `<a href="/?page=${data.currentPage - 1}" style="padding: 8px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">Sebelumnya</a> `;
                }
                phtml += `<span style="font-weight: bold;" id="page-info">Halaman ${data.currentPage} dari ${data.totalPages}</span> `;
                if (data.currentPage < data.totalPages) {
                    phtml += `<a href="/?page=${data.currentPage + 1}" style="padding: 8px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">Selanjutnya</a>`;
                }
                paginationControls.innerHTML = phtml;

            } catch (err) {
                console.error("Gagal refresh data statistik:", err);
            }
        }

        // Variabel Status Sync
        let syncPollInterval = null;

        // Cegah interaksi keyboard (Tab, Enter, Space) saat modal overlay aktif
        document.addEventListener('keydown', function(e) {
            if (document.body.classList.contains('sync-locked')) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);

        // Fungsi Memulai Sinkronisasi (Karyawan / Absensi)
        async function startSync(type) {
            // Lock UI & Tampilkan Modal
            document.body.classList.add('sync-locked');
            document.getElementById('sync-overlay').classList.add('active');
            document.getElementById('btn-close-modal').style.display = 'none';
            document.getElementById('sync-title').innerText = type === 'karyawan' ? 'Tarik Data Karyawan' : 'Tarik Data Absensi';
            updateProgressBar(0, 'Menghubungkan ke server...');

            try {
                // Panggil endpoint secara background/asynchronous (tanpa memblokir respons HTTP)
                const endpoint = type === 'karyawan' ? '/api/sync-karyawan?background=1' : '/api/sync-absensi?background=1';
                const res = await fetch(endpoint);
                const data = await res.json();

                if (!data.success && !data.alreadyRunning && !data.started) {
                    throw new Error(data.message || 'Gagal memulai sinkronisasi');
                }

                // Mulai polling status setiap 250ms
                syncPollInterval = setInterval(pollSyncStatus, 250);
            } catch (err) {
                showSyncResult('error', err.message);
            }
        }

        function updateProgressBar(progress, message, isError = false) {
            const bar = document.getElementById('sync-progress-bar');
            const pct = document.getElementById('sync-progress-text');
            const status = document.getElementById('sync-status-text');

            bar.style.width = progress + '%';
            bar.style.backgroundColor = isError ? '#dc3545' : (progress === 100 ? '#28a745' : '#007bff');
            pct.innerText = progress + '%';
            pct.style.color = isError ? '#dc3545' : (progress === 100 ? '#28a745' : '#007bff');
            status.innerText = message;
        }

        async function pollSyncStatus() {
            try {
                const res = await fetch('/api/sync-status');
                const state = await res.json();

                if (state.status === 'running' || state.isSyncing) {
                    updateProgressBar(state.progress, state.message);
                } else if (state.status === 'completed') {
                    clearInterval(syncPollInterval);
                    updateProgressBar(100, state.message);
                    finishSync(true);
                } else if (state.status === 'error') {
                    clearInterval(syncPollInterval);
                    updateProgressBar(100, state.message, true);
                    finishSync(false);
                }
            } catch (err) {
                // Jika server tidak merespon saat polling, biarkan saja (mungkin restart)
            }
        }

        function finishSync(success) {
            if (success) {
                // Beri waktu 1.5 detik bagi user untuk melihat hasil 100%, lalu refresh dan tutup
                setTimeout(() => {
                    refreshDashboardStats();
                    closeSyncModal();
                }, 1500);
            } else {
                // Jika error, jangan auto-close, tampilkan tombol Tutup
                document.getElementById('btn-close-modal').style.display = 'block';
            }
        }

        function showSyncResult(status, message) {
            if (syncPollInterval) clearInterval(syncPollInterval);
            updateProgressBar(100, message, status === 'error');
            document.getElementById('btn-close-modal').style.display = 'block';
        }

        function closeSyncModal() {
            if (syncPollInterval) clearInterval(syncPollInterval);
            document.getElementById('sync-overlay').classList.remove('active');
            document.body.classList.remove('sync-locked');
            refreshDashboardStats();
        }

        // Cek jika halaman direfresh di tengah-tengah sinkronisasi (lanjutkan overlay progress)
        window.addEventListener('load', async () => {
            try {
                const res = await fetch('/api/sync-status');
                const state = await res.json();
                if (state.isSyncing && state.status === 'running') {
                    // Lanjutkan tampilan sync
                    document.body.classList.add('sync-locked');
                    document.getElementById('sync-overlay').classList.add('active');
                    document.getElementById('sync-title').innerText = state.type === 'karyawan' ? 'Tarik Data Karyawan' : 'Tarik Data Absensi';
                    updateProgressBar(state.progress, state.message);
                    syncPollInterval = setInterval(pollSyncStatus, 250);
                }
            } catch (e) {}
        });

    </script>
</body>
</html>