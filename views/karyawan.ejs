<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Karyawan</title>
    <style>
        :root {
            --primary-blue: #0d47a1;
            --secondary-blue: #1976d2;
            --light-blue: #e3f2fd;
            --primary-yellow: #ffc107;
            --light-yellow: #fff8e1;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --white: #ffffff;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 24px;
            background: linear-gradient(135deg, #e3f2fd 0%, #fff8e1 100%);
            min-height: 100vh;
            color: var(--text-dark);
        }
        .container {
            max-width: 960px;
            margin: auto;
            background: var(--white);
            padding: 28px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(13, 71, 161, 0.1);
            border-top: 6px solid var(--primary-yellow);
        }
        h1, h2 {
            color: var(--primary-blue);
            text-align: center;
            margin-top: 0;
            font-weight: 700;
        }
        h1 {
            font-size: 26px;
            margin-bottom: 24px;
        }
        h1::after {
            content: '';
            display: block;
            width: 70px;
            height: 4px;
            background: var(--primary-yellow);
            margin: 8px auto 0;
            border-radius: 2px;
        }
        h2 {
            font-size: 18px;
            text-align: left;
            border-left: 5px solid var(--primary-yellow);
            padding-left: 12px;
            margin-bottom: 0;
        }
        .nav {
            margin-bottom: 24px;
            padding: 14px 18px;
            background: linear-gradient(90deg, var(--primary-blue), var(--secondary-blue));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            box-shadow: 0 4px 12px rgba(13, 71, 161, 0.18);
        }
        .nav a {
            text-decoration: none;
            color: var(--primary-blue);
            background: var(--primary-yellow);
            font-weight: 700;
            font-size: 14px;
            padding: 9px 16px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        }
        .nav a:hover {
            text-decoration: none;
            background: #ffd54f;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
        }

        .btn-open-modal {
            padding: 10px 20px;
            background-color: var(--primary-yellow);
            color: var(--primary-blue);
            cursor: pointer;
            border: none;
            font-weight: 700;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.2s ease;
            box-shadow: 0 3px 8px rgba(13, 71, 161, 0.15);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-open-modal:hover {
            background-color: #ffb300;
            transform: translateY(-1px);
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
        }
        table {
            width: 100%;
            min-width: 520px;
            border-collapse: collapse;
        }
        th, td {
            padding: 13px 16px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }
        th {
            background: linear-gradient(90deg, var(--primary-blue), var(--secondary-blue));
            color: var(--primary-yellow);
            font-weight: 700;
            white-space: nowrap;
        }
        tr:nth-child(even) { background-color: #f8fafc; }
        tr:hover { background-color: var(--light-yellow); }
        .action-links {
            white-space: nowrap;
        }
        .action-links a {
            margin-right: 8px;
            text-decoration: none;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            display: inline-block;
        }
        .btn-edit {
            background-color: var(--primary-yellow);
            color: var(--primary-blue) !important;
        }
        .btn-edit:hover { background-color: #ffb300; }
        .btn-delete { background-color: #dc3545; }
        .btn-delete:hover { background-color: #b02a37; }

        /* Modal Popup Tambah Karyawan */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(13, 71, 161, 0.7);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            padding: 16px;
        }
        .modal-overlay.active {
            display: flex;
        }
        .modal-card {
            background: var(--white);
            width: 100%;
            max-width: 460px;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
            border-top: 6px solid var(--primary-yellow);
            position: relative;
            animation: modalFadeIn 0.2s ease-out;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 12px;
        }
        .modal-header h3 {
            margin: 0;
            font-size: 20px;
            color: var(--primary-blue);
        }
        .btn-close-x {
            background: none;
            border: none;
            font-size: 24px;
            line-height: 1;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0 4px;
        }
        .btn-close-x:hover {
            color: var(--primary-blue);
        }
        .modal-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .form-group label {
            font-weight: 700;
            font-size: 14px;
            color: var(--primary-blue);
        }
        .form-group input {
            padding: 11px 14px;
            font-size: 15px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            width: 100%;
        }
        .form-group input:focus {
            outline: none;
            border-color: var(--secondary-blue);
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.15);
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 8px;
        }
        .btn-cancel {
            padding: 10px 18px;
            background-color: #e2e8f0;
            color: var(--text-dark);
            border: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
        }
        .btn-cancel:hover {
            background-color: #cbd5e1;
        }
        .btn-submit {
            padding: 10px 20px;
            background-color: var(--primary-yellow);
            color: var(--primary-blue);
            border: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
        }
        .btn-submit:hover {
            background-color: #ffb300;
        }

        /* Media Queries untuk Mobile & Tablet */
        @media (max-width: 768px) {
            body {
                padding: 12px;
            }
            .container {
                padding: 18px 14px;
                border-radius: 12px;
            }
            h1 {
                font-size: 22px;
                margin-bottom: 18px;
            }
            .header-bar {
                flex-direction: column;
                align-items: stretch;
            }
            .btn-open-modal {
                width: 100%;
                justify-content: center;
            }
            th, td {
                padding: 10px 12px;
                font-size: 13px;
            }
            .modal-card {
                padding: 20px 16px;
            }
            .modal-actions {
                flex-direction: column-reverse;
            }
            .btn-cancel, .btn-submit {
                width: 100%;
                padding: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav">
            <a href="/">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Kembali ke Dashboard
            </a>
        </div>
        
        <h1>Manajemen Karyawan</h1>
        
        <div class="header-bar">
            <h2>Daftar Karyawan</h2>
            <button type="button" class="btn-open-modal" onclick="openAddModal()">+ Tambah Karyawan</button>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nama</th>
                        <th>Jabatan/Bagian</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (karyawan.length > 0) { %>
                        <% karyawan.forEach(k => { %>
                            <tr>
                                <td><%= k.uid %></td>
                                <td><strong><%= k.nama %></strong></td>
                                <td><%= k.jabatan || '-' %></td>
                                <td class="action-links">
                                    <a href="/karyawan/edit/<%= k.uid %>" class="btn-edit">Edit</a>
                                    <a href="/karyawan/delete/<%= k.uid %>" class="btn-delete" onclick="return confirm('Yakin ingin menghapus karyawan ini?')">Hapus</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center;">Belum ada data karyawan.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Popup Tambah Karyawan -->
    <div id="add-karyawan-modal" class="modal-overlay" onclick="handleOverlayClick(event)">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Tambah Karyawan Baru</h3>
                <button type="button" class="btn-close-x" onclick="closeAddModal()" title="Tutup">&times;</button>
            </div>
            <form class="modal-form" action="/karyawan/add" method="POST">
                <div class="form-group">
                    <label for="input-nama">Nama Karyawan</label>
                    <input type="text" id="input-nama" name="nama" placeholder="Masukkan nama karyawan" required>
                </div>
                <div class="form-group">
                    <label for="input-jabatan">Jabatan / Bagian</label>
                    <input type="text" id="input-jabatan" name="jabatan" placeholder="Masukkan jabatan atau bagian" required>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeAddModal()">Batal</button>
                    <button type="submit" class="btn-submit">Simpan Karyawan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openAddModal() {
            const modal = document.getElementById('add-karyawan-modal');
            modal.classList.add('active');
            const namaInput = document.getElementById('input-nama');
            if (namaInput) setTimeout(() => namaInput.focus(), 50);
        }

        function closeAddModal() {
            const modal = document.getElementById('add-karyawan-modal');
            modal.classList.remove('active');
        }

        function handleOverlayClick(e) {
            if (e.target.id === 'add-karyawan-modal') {
                closeAddModal();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeAddModal();
            }
        });
    </script>
</body>
</html>
