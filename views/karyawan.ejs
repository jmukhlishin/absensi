    <script>
        const STRUKTUR_TREE = <%- JSON.stringify(typeof strukturTree !== 'undefined' ? strukturTree : []) %>;
        const PERUSAHAAN_MASTER = <%- JSON.stringify(typeof perusahaanList !== 'undefined' ? perusahaanList : []) %>;
        const DIVISI_MASTER = <%- JSON.stringify(typeof divisiList !== 'undefined' ? divisiList : []) %>;

        let currentSortColumn = 'id';
        let currentSortOrder = 'asc';

        // Helper fungsi Alert Banner
        function showAlert(message, type = 'success') {
            const box = document.getElementById('alert-box');
            const txt = document.getElementById('alert-text');
            if (!box || !txt) return;
            box.className = 'alert-banner show ' + (type === 'error' ? 'alert-error' : 'alert-success');
            txt.innerText = message;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hideAlert() {
            const box = document.getElementById('alert-box');
            if (box) box.classList.remove('show');
        }

        // Ambil semua perusahaan dari struktur perusahaan (dan master perusahaan)
        function getPerusahaanOptions() {
            const set = new Set();
            if (Array.isArray(STRUKTUR_TREE)) {
                STRUKTUR_TREE.forEach(node => {
                    if (node && node.tipe === 'perusahaan' && node.nama) {
                        set.add(String(node.nama).trim());
                    }
                });
            }
            if (Array.isArray(PERUSAHAAN_MASTER)) {
                PERUSAHAAN_MASTER.forEach(p => {
                    if (p && p.nama) set.add(String(p.nama).trim());
                });
            }
            return Array.from(set);
        }

        // Ambil daftar divisi berdasarkan perusahaan yang dipilih dari Struktur Perusahaan (hierarki/tree)
        function getDivisiOptionsForPerusahaan(namaPerusahaan) {
            const options = [];
            const seen = new Set();

            function collectDivisi(children, depth) {
                if (!Array.isArray(children)) return;
                children.forEach(child => {
                    if (!child || !child.nama) return;
                    const cleanName = String(child.nama).trim();
                    if (child.tipe === 'divisi' && cleanName) {
                        if (!seen.has(cleanName)) {
                            seen.add(cleanName);
                            const prefix = depth > 0 ? '— '.repeat(depth) : '';
                            options.push({ value: cleanName, label: prefix + cleanName });
                        }
                    }
                    if (Array.isArray(child.children) && child.children.length > 0) {
                        collectDivisi(child.children, depth + 1);
                    }
                });
            }

            if (namaPerusahaan && Array.isArray(STRUKTUR_TREE)) {
                STRUKTUR_TREE.forEach(rootNode => {
                    if (rootNode && rootNode.tipe === 'perusahaan' && String(rootNode.nama).trim() === String(namaPerusahaan).trim()) {
                        collectDivisi(rootNode.children, 0);
                    }
                });
            }

            // Fallback: jika perusahaan belum memiliki divisi di tree atau perusahaan belum dipilih, tampilkan divisi dari struktur/master
            if (options.length === 0) {
                if (Array.isArray(STRUKTUR_TREE)) {
                    STRUKTUR_TREE.forEach(rootNode => {
                        if (rootNode && rootNode.tipe === 'divisi' && rootNode.nama) {
                            const cleanName = String(rootNode.nama).trim();
                            if (!seen.has(cleanName)) {
                                seen.add(cleanName);
                                options.push({ value: cleanName, label: cleanName });
                            }
                        }
                        if (rootNode && Array.isArray(rootNode.children)) {
                            collectDivisi(rootNode.children, 0);
                        }
                    });
                }
                if (options.length === 0 && Array.isArray(DIVISI_MASTER)) {
                    DIVISI_MASTER.forEach(d => {
                        if (d && d.nama) {
                            const cleanName = String(d.nama).trim();
                            if (cleanName && !seen.has(cleanName)) {
                                seen.add(cleanName);
                                options.push({ value: cleanName, label: cleanName });
                            }
                        }
                    });
                }
            }

            return options;
        }

        function populatePerusahaanSelect(selectId, selectedValue) {
            const selectEl = document.getElementById(selectId);
            if (!selectEl) return;
            const list = getPerusahaanOptions();
            if (selectedValue && !list.includes(selectedValue)) {
                list.push(selectedValue);
            }
            let html = '<option value="">-- Pilih Perusahaan --</option>';
            list.forEach(p => {
                const isSelected = p === selectedValue ? ' selected' : '';
                const escaped = p.replace(/"/g, '&quot;');
                html += `<option value="${escaped}"${isSelected}>${p}</option>`;
            });
            selectEl.innerHTML = html;
        }

        function populateDivisiSelect(selectId, namaPerusahaan, selectedDivisi) {
            const selectEl = document.getElementById(selectId);
            if (!selectEl) return;
            const list = getDivisiOptionsForPerusahaan(namaPerusahaan);
            if (selectedDivisi && !list.some(item => item.value === selectedDivisi)) {
                list.push({ value: selectedDivisi, label: selectedDivisi });
            }
            let html = '<option value="">-- Pilih Divisi --</option>';
            list.forEach(item => {
                const isSelected = item.value === selectedDivisi ? ' selected' : '';
                const escaped = item.value.replace(/"/g, '&quot;');
                html += `<option value="${escaped}"${isSelected}>${item.label}</option>`;
            });
            selectEl.innerHTML = html;
        }

        function onPerusahaanChange(mode) {
            if (mode === 'edit') {
                const perusahaanVal = document.getElementById('edit-perusahaan').value;
                populateDivisiSelect('edit-divisi', perusahaanVal, '');
            } else if (mode === 'add') {
                const perusahaanVal = document.getElementById('add-perusahaan').value;
                populateDivisiSelect('add-divisi', perusahaanVal, '');
            }
        }

        // Filter Daftar Karyawan berdasarkan Perusahaan
        function filterByPerusahaan() {
            const filterVal = (document.getElementById('filter-perusahaan').value || '').trim();
            const tbody = document.getElementById('karyawan-tbody');
            const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
            const existingFilterEmpty = document.getElementById('filter-empty-row');
            if (existingFilterEmpty) existingFilterEmpty.remove();

            if (rows.length === 0) return;

            let visibleCount = 0;
            rows.forEach(row => {
                const rowPerusahaan = (row.getAttribute('data-perusahaan') || '').trim();
                if (!filterVal || rowPerusahaan === filterVal) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                const tr = document.createElement('tr');
                tr.id = 'filter-empty-row';
                tr.innerHTML = '<td colspan="6" style="text-align: center;">Tidak ada data karyawan pada perusahaan ini.</td>';
                tbody.appendChild(tr);
            }
        }

        function sortTable(column) {
            const tbody = document.getElementById('karyawan-tbody');
            const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
            if (rows.length === 0) return;

            if (currentSortColumn === column) {
                currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortOrder = 'asc';
            }

            rows.sort((a, b) => {
                if (column === 'id') {
                    const idA = a.getAttribute('data-id') || '';
                    const idB = b.getAttribute('data-id') || '';
                    const numA = parseInt(idA, 10);
                    const numB = parseInt(idB, 10);
                    let cmp = 0;
                    if (!isNaN(numA) && !isNaN(numB) && String(numA) === idA && String(numB) === idB) {
                        cmp = numA - numB;
                    } else {
                        cmp = idA.localeCompare(idB, undefined, { numeric: true, sensitivity: 'base' });
                    }
                    return currentSortOrder === 'asc' ? cmp : -cmp;
                } else {
                    const namaA = (a.getAttribute('data-nama') || '').toLowerCase();
                    const namaB = (b.getAttribute('data-nama') || '').toLowerCase();
                    const cmp = namaA.localeCompare(namaB, 'id');
                    return currentSortOrder === 'asc' ? cmp : -cmp;
                }
            });

            rows.forEach(row => tbody.appendChild(row));

            const filterEmptyRow = document.getElementById('filter-empty-row');
            if (filterEmptyRow) tbody.appendChild(filterEmptyRow);

            document.getElementById('sort-icon-id').innerText = '⇕';
            document.getElementById('sort-icon-nama').innerText = '⇕';
            const activeIcon = document.getElementById('sort-icon-' + column);
            if (activeIcon) {
                activeIcon.innerText = currentSortOrder === 'asc' ? '▲' : '▼';
            }
        }

        function openAddModal() {
            populatePerusahaanSelect('add-perusahaan', '');
            populateDivisiSelect('add-divisi', '', '');
            const modal = document.getElementById('add-karyawan-modal');
            modal.classList.add('active');
            const namaInput = document.getElementById('input-nama');
            if (namaInput) setTimeout(() => namaInput.focus(), 50);
        }

        function closeAddModal() {
            const modal = document.getElementById('add-karyawan-modal');
            modal.classList.remove('active');
        }

        function openEditModalFromBtn(btn) {
            const uid = btn.getAttribute('data-uid') || '';
            const nama = btn.getAttribute('data-nama') || '';
            const perusahaan = btn.getAttribute('data-perusahaan') || '';
            const divisi = btn.getAttribute('data-divisi') || '';
            const jabatan = btn.getAttribute('data-jabatan') || '';

            const form = document.getElementById('edit-karyawan-form');
            form.action = '/karyawan/edit/' + encodeURIComponent(uid);

            document.getElementById('edit-uid').value = uid;
            document.getElementById('edit-nama').value = nama;
            document.getElementById('edit-jabatan').value = jabatan;

            populatePerusahaanSelect('edit-perusahaan', perusahaan);
            populateDivisiSelect('edit-divisi', perusahaan, divisi);

            const modal = document.getElementById('edit-karyawan-modal');
            modal.classList.add('active');
        }

        function closeEditModal() {
            const modal = document.getElementById('edit-karyawan-modal');
            modal.classList.remove('active');
        }

        function openExportModal() {
            const modal = document.getElementById('export-karyawan-modal');
            modal.classList.add('active');
        }

        function closeExportModal() {
            const modal = document.getElementById('export-karyawan-modal');
            modal.classList.remove('active');
        }

        function openUploadSelectModal() {
            const modal = document.getElementById('upload-select-modal');
            modal.classList.add('active');
        }

        function closeUploadSelectModal() {
            const modal = document.getElementById('upload-select-modal');
            modal.classList.remove('active');
        }

        // Logic Hapus Karyawan (Opsi & Konfirmasi)
        let targetDeleteUid = '';
        let targetDeleteNama = '';

        function openDeleteOptionModalFromBtn(btn) {
            targetDeleteUid = btn.getAttribute('data-uid');
            targetDeleteNama = btn.getAttribute('data-nama');
            document.getElementById('opt-del-uid').innerText = targetDeleteUid;
            document.getElementById('opt-del-nama').innerText = targetDeleteNama;
            const modal = document.getElementById('delete-option-modal');
            modal.classList.add('active');
        }

        function closeDeleteOptionModal() {
            const modal = document.getElementById('delete-option-modal');
            modal.classList.remove('active');
        }

        function openDeleteConfirmModal() {
            const selectedRadio = document.querySelector('input[name="delete_target"]:checked');
            if (!selectedRadio) return;
            const target = selectedRadio.value;
            
            closeDeleteOptionModal();

            const confirmMsg = document.getElementById('confirm-del-message');
            const confirmNote = document.getElementById('confirm-del-note');
            
            if (target === 'mesin') {
                confirmMsg.innerHTML = `Apakah Anda yakin ingin menghapus karyawan <strong>${targetDeleteNama}</strong> (ID: <strong>${targetDeleteUid}</strong>) dari <strong>Mesin Absensi</strong>?`;
                confirmNote.innerHTML = 'Data karyawan akan dihapus dari mesin absensi melalui koneksi server ke mesin. Data absensi & karyawan pada database aplikasi lokal tidak akan ikut terhapus.';
            } else {
                confirmMsg.innerHTML = `Apakah Anda yakin ingin menghapus karyawan <strong>${targetDeleteNama}</strong> (ID: <strong>${targetDeleteUid}</strong>) dari <strong>Database</strong>?`;
                confirmNote.innerHTML = 'Data karyawan (dan seluruh relasi log absensinya) akan dihapus secara permanen dari database lokal aplikasi.';
            }

            const btnConfirm = document.getElementById('btn-confirm-delete');
            btnConfirm.setAttribute('data-target', target);
            btnConfirm.innerText = 'Ya, Hapus';
            btnConfirm.disabled = false;

            const modal = document.getElementById('delete-confirm-modal');
            modal.classList.add('active');
        }

        function closeDeleteConfirmModal() {
            const modal = document.getElementById('delete-confirm-modal');
            modal.classList.remove('active');
        }

        async function confirmDeleteKaryawan() {
            const btnConfirm = document.getElementById('btn-confirm-delete');
            const target = btnConfirm.getAttribute('data-target');
            
            btnConfirm.disabled = true;
            
            const apiEndpoint = target === 'mesin' ? '/api/karyawan/delete-machine' : '/api/karyawan/delete-database';
            
            if (target === 'mesin') {
                btnConfirm.innerText = 'Menghubungkan ke mesin...';
            } else {
                btnConfirm.innerText = 'Menghapus...';
            }

            try {
                const response = await fetch(apiEndpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid: targetDeleteUid, nama: targetDeleteNama })
                });
                const result = await response.json();
                
                closeDeleteConfirmModal();
                
                if (result.success) {
                    if (target === 'database') {
                        // Hapus row dari tabel jika dihapus dari database
                        const row = document.querySelector(`tr[data-id="${targetDeleteUid}"]`);
                        if (row) row.remove();
                    }
                    showAlert(result.message || 'Karyawan berhasil dihapus!', 'success');
                } else {
                    showAlert(result.message || 'Gagal menghapus karyawan.', 'error');
                }
            } catch (err) {
                closeDeleteConfirmModal();
                showAlert('Terjadi kesalahan koneksi/server.', 'error');
            }
        }

        function handleOverlayClick(e) {
            if (e.target.id === 'add-karyawan-modal') {
                closeAddModal();
            } else if (e.target.id === 'edit-karyawan-modal') {
                closeEditModal();
            } else if (e.target.id === 'upload-select-modal') {
                closeUploadSelectModal();
            } else if (e.target.id === 'export-karyawan-modal') {
                closeExportModal();
            } else if (e.target.id === 'delete-option-modal') {
                closeDeleteOptionModal();
            } else if (e.target.id === 'delete-confirm-modal') {
                closeDeleteConfirmModal();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeAddModal();
                closeEditModal();
                closeUploadSelectModal();
                closeExportModal();
                closeDeleteOptionModal();
                closeDeleteConfirmModal();
            }
            if (document.body.classList.contains('upload-locked')) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
        
        function toggleCheckAll() {
            const checkAll = document.getElementById('checkAll');
            const checkboxes = document.querySelectorAll('.karyawan-checkbox');
            checkboxes.forEach(cb => cb.checked = checkAll.checked);
        }

        function toggleRowCheckbox(row, event) {
            if (event.target.tagName.toLowerCase() === 'input') return;
            const cb = row.querySelector('.karyawan-checkbox');
            if (cb) {
                cb.checked = !cb.checked;
                updateCheckAllState();
            }
        }

        function updateCheckAllState() {
            const checkAll = document.getElementById('checkAll');
            const checkboxes = document.querySelectorAll('.karyawan-checkbox');
            if (!checkAll || checkboxes.length === 0) return;
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkAll.checked = allChecked;
        }
        
        async function uploadSelected() {
            const checkboxes = document.querySelectorAll('.karyawan-checkbox:checked');
            if (checkboxes.length === 0) {
                alert('Silakan centang setidaknya satu karyawan untuk diupload!');
                return;
            }
            
            const selectedUsers = Array.from(checkboxes).map(cb => ({
                uid: cb.value,
                nama: cb.getAttribute('data-nama')
            }));
            
            closeUploadSelectModal();

            // Kunci UI dan tampilkan modal progress
            document.body.classList.add('upload-locked');
            document.getElementById('upload-overlay').classList.add('active');
            document.getElementById('btn-close-upload').style.display = 'none';
            document.getElementById('upload-title').innerText = 'Mengupload Data ke Mesin...';
            
            updateUploadProgress(5, 'Menghubungkan ke server...');
            
            try {
                const response = await fetch('/api/upload-karyawan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ users: selectedUsers })
                });
                
                // Gunakan reader agar bisa update progress bar per baris JSON
                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let buffer = '';
                
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    
                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop(); // simpan sisa potongan JSON ke buffer
                    
                    for (const line of lines) {
                        if (line.trim() !== '') {
                            try {
                                const data = JSON.parse(line);
                                if (data.status === 'running') {
                                    updateUploadProgress(data.progress, data.message);
                                } else if (data.status === 'completed') {
                                    updateUploadProgress(100, data.message);
                                    document.getElementById('btn-close-upload').style.display = 'block';
                                    document.getElementById('upload-title').innerText = 'Upload Selesai!';
                                } else if (data.status === 'error') {
                                    updateUploadProgress(100, data.message, true);
                                    document.getElementById('btn-close-upload').style.display = 'block';
                                    document.getElementById('upload-title').innerText = 'Upload Gagal!';
                                }
                            } catch (e) {
                                console.error('Gagal parse JSON stream:', e);
                            }
                        }
                    }
                }
            } catch (err) {
                updateUploadProgress(100, 'Terjadi kesalahan: ' + err.message, true);
                document.getElementById('btn-close-upload').style.display = 'block';
                document.getElementById('upload-title').innerText = 'Upload Gagal!';
            }
        }
        
        function updateUploadProgress(progress, message, isError = false) {
            const bar = document.getElementById('upload-progress-bar');
            const pct = document.getElementById('upload-progress-text');
            const status = document.getElementById('upload-status-text');
            
            bar.style.width = progress + '%';
            bar.style.backgroundColor = isError ? '#dc3545' : (progress === 100 ? '#16a34a' : '#1976d2');
            pct.innerText = progress + '%';
            pct.style.color = isError ? '#dc3545' : (progress === 100 ? '#16a34a' : '#0d47a1');
            status.innerText = message;
        }
        
        function closeUploadModal() {
            document.body.classList.remove('upload-locked');
            document.getElementById('upload-overlay').classList.remove('active');
            // Uncheck semua checkbox
            const checkAll = document.getElementById('checkAll');
            if (checkAll) checkAll.checked = false;
            document.querySelectorAll('.karyawan-checkbox').forEach(cb => cb.checked = false);
        }
    </script>
</body>
</html>
