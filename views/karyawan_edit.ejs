<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Karyawan</title>
    <style>
        :root {
            --primary-blue: #0d47a1;
            --secondary-blue: #1976d2;
            --primary-yellow: #ffc107;
            --text-dark: #1e293b;
            --white: #ffffff;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 24px;
            background: linear-gradient(135deg, #e3f2fd 0%, #fff8e1 100%);
            min-height: 100vh;
            color: var(--text-dark);
        }
        .container {
            max-width: 520px;
            margin: auto;
            background: var(--white);
            padding: 28px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(13, 71, 161, 0.1);
            border-top: 6px solid var(--primary-yellow);
        }
        h1 {
            color: var(--primary-blue);
            text-align: center;
            margin-top: 0;
            font-size: 24px;
        }
        h1::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: var(--primary-yellow);
            margin: 8px auto 0;
            border-radius: 2px;
        }
        .nav {
            margin-bottom: 24px;
            padding: 12px 16px;
            background: linear-gradient(90deg, var(--primary-blue), var(--secondary-blue));
            border-radius: 10px;
        }
        .nav a {
            text-decoration: none;
            color: var(--primary-yellow);
            font-weight: 700;
        }
        .nav a:hover { text-decoration: underline; }
        
        form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 700;
            color: var(--primary-blue);
        }
        input {
            width: 100%;
            padding: 11px 14px;
            font-size: 15px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
        }
        input:focus {
            outline: none;
            border-color: var(--secondary-blue);
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.15);
        }
        button {
            padding: 12px;
            background-color: var(--primary-yellow);
            color: var(--primary-blue);
            cursor: pointer;
            border: none;
            font-weight: 700;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.2s ease;
        }
        button:hover {
            background-color: #ffb300;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav">
            <a href="/karyawan">&larr; Kembali ke Daftar Karyawan</a>
        </div>
        
        <h1>Edit Karyawan</h1>
        
        <form action="/karyawan/edit/<%= k.uid %>" method="POST">
            <div>
                <label>UID/PIN Mesin Absen</label>
                <input type="text" name="uid" value="<%= k.uid %>" required>
            </div>
            <div>
                <label>Nama Karyawan</label>
                <input type="text" name="nama" value="<%= k.nama %>" required>
            </div>
            <button type="submit">Simpan Perubahan</button>
        </form>
    </div>
</body>
</html>
