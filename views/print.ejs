<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Laporan Kehadiran</title>
    <style>
        @page {
            size: landscape;
            margin: 10mm;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            color: #1e293b;
            background-color: #fff;
        }
        .container {
            width: 100%;
            max-width: 100%;
            margin: auto;
        }
        h1, h2, h3 {
            text-align: center;
            margin: 0 0 6px 0;
            color: #0d47a1;
        }
        .date {
            text-align: center;
            margin-bottom: 16px;
            font-style: italic;
            font-size: 13px;
            color: #475569;
        }
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 11px;
        }
        th, td {
            border: 1px solid #334155;
            padding: 6px 8px;
            text-align: center;
            white-space: nowrap;
        }
        th {
            background-color: #0d47a1;
            color: #ffc107;
            font-weight: 700;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        th.sub-header {
            background-color: #fff8e1;
            color: #0d47a1;
            font-size: 10px;
        }
        td.emp-name {
            text-align: left;
            font-weight: 600;
            background-color: #f8fafc;
            position: sticky;
            left: 0;
        }
        tr:nth-child(even) td {
            background-color: #f8fafc;
        }
        @media print {
            @page {
                size: landscape;
            }
            .no-print { display: none !important; }
            body { padding: 0; }
            .table-wrapper { overflow: visible; }
            td.emp-name { position: static; }
        }
        .btn-print {
            display: block;
            width: 180px;
            margin: 20px auto;
            padding: 10px 16px;
            text-align: center;
            background-color: #0d47a1;
            color: #ffc107;
            text-decoration: none;
            border-radius: 8px;
            border: 2px solid #ffc107;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
        }
        .btn-print:hover {
            background-color: #ffc107;
            color: #0d47a1;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Rekap Kehadiran Karyawan</h1>
        <% if (typeof start !== 'undefined' && typeof end !== 'undefined' && start && end) { %>
            <h3 style="margin-bottom: 6px;">Periode: <%= start %> s/d <%= end %></h3>
        <% } %>
        <div class="date">Dicetak pada: <span id="print-date"></span></div>
        
        <%
            // Susun daftar tanggal unik secara horizontal (memanjang ke samping)
            const dateSet = new Set();
            const empMap = new Map();

            if (Array.isArray(laporan)) {
                laporan.forEach(row => {
                    if (row.tanggal) dateSet.add(row.tanggal);
                    const empName = row.nama || 'Tidak Diketahui';
                    if (!empMap.has(empName)) {
                        empMap.set(empName, {});
                    }
                    empMap.get(empName)[row.tanggal] = {
                        in: row.check_in ? row.check_in.slice(0, 5) : '-',
                        out: row.check_out ? row.check_out.slice(0, 5) : '-'
                    };
                });
            }

            const dates = Array.from(dateSet).sort();
            const employees = Array.from(empMap.keys()).sort((a, b) => a.localeCompare(b));
        %>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th rowspan="2" style="min-width: 36px;">No</th>
                        <th rowspan="2" style="text-align: left; min-width: 150px;">Nama Karyawan</th>
                        <% if (dates.length > 0) { %>
                            <% dates.forEach(tgl => { %>
                                <th colspan="2"><%= tgl %></th>
                            <% }) %>
                        <% } else { %>
                            <th>Tanggal</th>
                        <% } %>
                    </tr>
                    <tr>
                        <% if (dates.length > 0) { %>
                            <% dates.forEach(() => { %>
                                <th class="sub-header">Masuk</th>
                                <th class="sub-header">Pulang</th>
                            <% }) %>
                        <% } else { %>
                            <th class="sub-header">-</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (employees.length > 0 && dates.length > 0) { %>
                        <% employees.forEach((empName, idx) => { %>
                            <tr>
                                <td><%= idx + 1 %></td>
                                <td class="emp-name"><%= empName %></td>
                                <% dates.forEach(tgl => { 
                                    const rec = empMap.get(empName)[tgl];
                                    const checkIn = rec ? rec.in : '-';
                                    const checkOut = rec ? (rec.in === rec.out ? '-' : rec.out) : '-';
                                %>
                                    <td><%= checkIn %></td>
                                    <td><%= checkOut %></td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="<%= dates.length > 0 ? (dates.length * 2 + 2) : 3 %>" style="text-align: center; padding: 20px;">Tidak ada data kehadiran.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <button class="no-print btn-print" onclick="window.print()">🖨️ Cetak Sekarang</button>
    </div>

    <script>
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
        document.getElementById('print-date').innerText = now.toLocaleDateString('id-ID', options);
        
        // Auto trigger print when page loads
        window.onload = function() {
            setTimeout(function() {
                window.print();
            }, 500);
        };
    </script>
</body>
</html>
